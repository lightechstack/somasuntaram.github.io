---
// Public-safe resume: no phone number, employers described by domain,
// no business-sensitive figures. The detailed resume (with company names)
// is sent directly to employers, never hosted here.
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';

const experience = [
  {
    title: 'Lead DevOps Engineer',
    where: 'Enterprise omni-channel SaaS',
    when: 'Apr 2025 – Present',
    points: [
      'Leading the migration of a high-traffic production platform from Heroku to AWS containers, retiring nearly all legacy hosting spend.',
      'Built event-driven autoscaling for background worker services, scaling out in about a minute under load spikes.',
      'Moved database and cache traffic to private networking, cutting network egress cost about 75% and cache latency about 30%.',
      'Reduced load-balancer errors 8× and p90 latency 23% through connection tuning, safer rollouts and latency/error alerting.',
      'Built AI-assisted operations tooling on MCP that gives engineers read-only, audited access for debugging, with no direct credentials.',
      'Supported SOC 2 and GDPR readiness and security remediation across cloud, CDN and logging.',
      'Infrastructure as code with Terraform and Kubernetes across AWS and Google Cloud.',
    ],
  },
  {
    title: 'Senior DevOps Engineer',
    where: 'Fintech payments platform · promoted after 18 months',
    when: 'Apr 2024 – Apr 2025',
    points: [
      'Owned AWS infrastructure for a financial transaction platform: compute, networking, storage, security and deployments.',
      'Ran MongoDB Atlas in production for real-time AML, transaction monitoring and risk systems: query tuning, scaling, backup and recovery.',
      'Set up site-to-site and client VPNs with banking partners; built hybrid infrastructure for an enterprise customer’s on-prem Azure environment.',
      'Centralised logging with Elasticsearch, Fluentd and Kibana; provided infrastructure evidence for SOC 2, PCI DSS 4.0 and ISO 27001 audits.',
    ],
  },
  {
    title: 'DevOps Engineer',
    where: 'Fintech payments platform · founding DevOps hire',
    when: 'Sep 2022 – Mar 2024',
    points: [
      'Built core AWS infrastructure from scratch: VPC, subnets, security groups, IAM, EC2, EKS clusters, RDS, S3 and Route53.',
      'Set up Jenkins CI/CD with SonarQube, Gitleaks, dependency scanning and Docker image checks; ran an EMQX (MQTT) broker for real-time IoT messaging.',
      'Implemented Linux hardening, patch management, encryption and access policies for PCI DSS 4.0, ISO 27001 and SOC 2 audits; set up Prometheus and Grafana with on-call alerting.',
    ],
  },
  {
    title: 'Associate DevOps Engineer',
    where: 'Zero Trust cloud security product',
    when: 'Aug 2021 – Aug 2022',
    points: [
      'Managed GKE deployments with Helm: chart configuration, deployment runs and Kubernetes troubleshooting.',
      'Built Grafana dashboards for Percona MySQL clusters; investigated production incidents and wrote post-mortems.',
    ],
  },
];

const skills = [
  ['Cloud', 'AWS (primary), Google Cloud, Azure'],
  ['Containers', 'Docker, Kubernetes, Amazon ECS (EC2 and Fargate), Amazon EKS, GKE Autopilot, Helm'],
  ['IaC & CI/CD', 'Terraform, CloudFormation, AWS CodeBuild, Cloud Build, Jenkins, GitHub Actions, Bash'],
  ['Observability', 'CloudWatch, Prometheus, Grafana, New Relic, Sumo Logic, EFK (Elasticsearch/Fluentd/Kibana)'],
  ['Security', 'Least-privilege IAM, Workload Identity, SSM Session Manager, AWS and GCP Secret Manager, WAF, SonarQube, Gitleaks'],
  ['Compliance', 'SOC 2, PCI DSS 4.0, ISO 27001, GDPR, data residency'],
  ['AI platform', 'MCP (Model Context Protocol) servers, AI-assisted operations tooling'],
  ['Data & messaging', 'MongoDB Atlas, MySQL (Percona), Redis/BullMQ queues, EMQX (MQTT)'],
  ['Linux & networking', 'Linux (production), VPC design, VPC peering, ALB, NAT, DNS, site-to-site/client VPN'],
];
---
<BaseLayout title="Resume — Somasuntaram" description="Resume of Somasuntaram, DevOps & Platform Engineer.">
  <article class="resume">
    <header class="r-head">
      <div>
        <h1>Somasuntaram MU</h1>
        <p class="r-title">{profile.title} · {profile.location}</p>
        <p class="r-contact">
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
          <span aria-hidden="true">·</span>
          <a href={profile.linkedin}>linkedin.com/in/somasuntaram</a>
        </p>
      </div>
      <button class="btn btn-secondary r-print" type="button" onclick="window.print()">Save as PDF</button>
    </header>

    <section>
      <h2>Summary</h2>
      <p>
        DevOps & Platform Engineer with {profile.years} years running cloud
        infrastructure in fintech and SaaS, usually as the sole or founding
        DevOps hire. Leading a high-traffic platform migration from Heroku to
        AWS containers and building AI-assisted operations tooling. Previously
        built AWS infrastructure from scratch for a PCI DSS, SOC 2 and ISO
        27001 certified payments platform.
      </p>
    </section>

    <section>
      <h2>Experience</h2>
      {experience.map((e) => (
        <div class="r-job">
          <div class="r-job-head">
            <h3>{e.title}</h3>
            <span class="r-when">{e.when}</span>
          </div>
          <p class="r-where">{e.where}</p>
          <ul>{e.points.map((p) => <li>{p}</li>)}</ul>
        </div>
      ))}
    </section>

    <section>
      <h2>Skills</h2>
      <dl class="r-skills">
        {skills.map(([k, v]) => (
          <>
            <dt>{k}</dt>
            <dd>{v}</dd>
          </>
        ))}
      </dl>
    </section>

    <section>
      <h2>Certifications & education</h2>
      <ul class="r-plain">
        <li><strong>Certified Kubernetes Administrator (CKA)</strong>: in progress, expected Dec 2026</li>
        <li><strong>B.E. Electronics & Instrumentation Engineering</strong>: Hindusthan College of Engineering and Technology, 2015 – 2019</li>
      </ul>
    </section>
  </article>
</BaseLayout>

<style>
  .resume {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: clamp(1.5rem, 5vw, 3rem);
  }
  .r-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--line);
  }
  .r-head h1 { margin: 0 0 0.25rem; font-size: clamp(1.8rem, 4vw, 2.4rem); letter-spacing: -0.035em; }
  .r-title { margin: 0 0 0.4rem; color: var(--ink-muted); font-weight: 500; }
  .r-contact { margin: 0; font-size: 0.925rem; display: flex; flex-wrap: wrap; gap: 0.5rem; color: var(--ink-muted); }
  .r-print { flex-shrink: 0; cursor: pointer; font-family: inherit; }
  .resume section { margin-top: 2rem; }
  .resume h2 {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--signal);
    margin: 0 0 0.9rem;
  }
  .r-job { margin-bottom: 1.5rem; }
  .r-job-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; flex-wrap: wrap; }
  .r-job h3 { margin: 0; font-size: 1.05rem; }
  .r-when { font-size: 0.875rem; color: var(--ink-muted); font-variant-numeric: tabular-nums; }
  .r-where { margin: 0.1rem 0 0.5rem; font-size: 0.9rem; color: var(--ink-muted); }
  .r-job ul { margin: 0; font-size: 0.94rem; }
  .r-skills { display: grid; grid-template-columns: 160px 1fr; gap: 0.45rem 1.25rem; margin: 0; font-size: 0.94rem; }
  .r-skills dt { font-weight: 600; color: var(--ink); }
  .r-skills dd { margin: 0; }
  .r-plain { padding-left: 1.1rem; font-size: 0.94rem; }
  @media (max-width: 560px) {
    .r-head { flex-direction: column; }
    .r-skills { grid-template-columns: 1fr; gap: 0.1rem; }
    .r-skills dd { margin-bottom: 0.6rem; }
  }

  @media print {
    :global(:root) {
      --bg: #fff; --surface: #fff; --surface-2: #f4f4f5; --ink: #09090b;
      --ink-soft: #27272a; --ink-muted: #52525b; --line: #e4e4e7; --signal: #1d4ed8;
    }
    :global(.site-header), :global(.site-footer), :global(.back-link), .r-print { display: none !important; }
    :global(html), :global(body) { background: #fff !important; color: #111 !important; font-size: 10.5pt; }
    :global(.site-main) { padding: 0 !important; max-width: none !important; }
    .resume { border: 0; box-shadow: none; padding: 0; background: #fff; }
    .resume section { margin-top: 1.1rem; break-inside: avoid-page; }
    .r-job { break-inside: avoid; margin-bottom: 0.9rem; }
    a { color: #111; text-decoration: none; }
  }
</style>
