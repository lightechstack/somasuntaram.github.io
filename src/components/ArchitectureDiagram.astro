---
// Hand-authored, traced directly from terraform/*.tf and
// .github/workflows/deploy.yml — not a stock icon diagram. If the infra
// changes, this should change with it.
---
<div class="diagram">
  <svg viewBox="0 0 700 260" role="img" aria-labelledby="arch-diagram-title">
    <title id="arch-diagram-title">Request path and deploy path for this site's infrastructure</title>
    <defs>
      <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0,0 L10,5 L0,10 z" class="arrow-head" />
      </marker>
    </defs>

    <!-- request path -->
    <g class="node"><rect x="10" y="20" width="140" height="60" rx="4" /><text x="80" y="55">Browser</text></g>
    <g class="node"><rect x="180" y="20" width="140" height="60" rx="4" /><text x="250" y="48">Route53</text><text x="250" y="64" class="sub">DNS</text></g>
    <g class="node"><rect x="350" y="20" width="140" height="60" rx="4" /><text x="420" y="42">CloudFront</text><text x="420" y="58" class="sub">OAC · ACM</text><text x="420" y="72" class="sub">us-east-1</text></g>
    <g class="node"><rect x="520" y="20" width="140" height="60" rx="4" /><text x="590" y="48">S3</text><text x="590" y="64" class="sub">private</text></g>

    <!-- deploy path -->
    <g class="node"><rect x="10" y="190" width="170" height="60" rx="4" /><text x="95" y="216">GitHub</text><text x="95" y="232" class="sub">Actions</text></g>
    <g class="node"><rect x="230" y="190" width="190" height="60" rx="4" /><text x="325" y="212">IAM role</text><text x="325" y="228" class="sub">via OIDC</text><text x="325" y="242" class="sub">main branch only</text></g>

    <!-- arrows: request path -->
    <line x1="150" y1="50" x2="176" y2="50" class="edge" marker-end="url(#arrow)" />
    <line x1="320" y1="50" x2="346" y2="50" class="edge" marker-end="url(#arrow)" />
    <line x1="490" y1="50" x2="516" y2="50" class="edge" marker-end="url(#arrow)" />
    <text x="503" y="40" class="edge-label" text-anchor="middle">OAC read</text>

    <!-- arrow: deploy path -->
    <line x1="180" y1="220" x2="226" y2="220" class="edge" marker-end="url(#arrow)" />
    <text x="203" y="210" class="edge-label" text-anchor="middle">assume-role</text>

    <!-- arrows: deploy actions reaching into the request path -->
    <line x1="360" y1="190" x2="420" y2="84" class="edge edge-dashed" marker-end="url(#arrow)" />
    <text x="410" y="150" class="edge-label" text-anchor="middle">invalidate</text>

    <line x1="400" y1="190" x2="580" y2="84" class="edge edge-dashed" marker-end="url(#arrow)" />
    <text x="560" y="170" class="edge-label" text-anchor="middle">s3 sync</text>
  </svg>
</div>

<style>
  .node rect {
    fill: var(--surface);
    stroke: var(--line);
    stroke-width: 1;
  }
  .node text {
    fill: var(--ink);
    font-size: 13px;
    text-anchor: middle;
    font-family: var(--mono);
  }
  .node text.sub {
    fill: var(--ink-muted);
    font-size: 11px;
  }
  .edge {
    stroke: var(--ink-muted);
    stroke-width: 1.25;
  }
  .edge-dashed {
    stroke-dasharray: 4 3;
  }
  .edge-label {
    fill: var(--ink-muted);
    font-size: 10.5px;
    font-family: var(--mono);
  }
  .arrow-head {
    fill: var(--ink-muted);
  }
</style>
