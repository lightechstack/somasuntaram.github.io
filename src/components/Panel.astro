---
interface Props {
  title: string;
  id?: string;
}
const { title, id } = Astro.props;
// The "Overview" panel on each page holds the page's h1 — render it as an
// unboxed page header rather than a card titled "Overview".
const isIntro = title === 'Overview';
---
{isIntro ? (
  <section class="page-intro" id={id}>
    <slot />
  </section>
) : (
  <section class="panel" id={id}>
    <h2 class="panel-title">{title}</h2>
    <div class="panel-body">
      <slot />
    </div>
  </section>
)}
