---
import { caseStudies } from '../data/profile';
---
<div class="cs-grid">
  {caseStudies.map((cs) => (
    <a class={`cs-card is-${cs.status}`} href={`/work/${cs.slug}`}>
      <div class="cs-top">
        <span class={`tag-status ${cs.status}`}>{cs.status === 'ready' ? 'case study' : 'in progress'}</span>
        <span class="cs-arrow" aria-hidden="true">↗</span>
      </div>
      <h3>{cs.title}</h3>
      <p>{cs.summary}</p>
      <div class="cs-tags">
        {cs.tags.map((t) => <span>{t}</span>)}
      </div>
    </a>
  ))}
</div>

<style>
  .cs-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  @media (max-width: 680px) { .cs-grid { grid-template-columns: 1fr; } }

  .cs-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink-soft);
    text-decoration: none;
    overflow: hidden;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .cs-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(400px 160px at 0% 0%, color-mix(in srgb, var(--signal) 9%, transparent), transparent 70%);
    opacity: 0;
    transition: opacity 0.25s ease;
    pointer-events: none;
  }
  .cs-card:hover { color: var(--ink-soft); transform: translateY(-3px); border-color: color-mix(in srgb, var(--signal) 35%, var(--line)); box-shadow: var(--shadow-hover); }
  .cs-card:hover::before { opacity: 1; }
  .cs-card.is-blocked { opacity: 0.75; }
  .cs-card.is-blocked:hover { opacity: 1; }

  .cs-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.25rem; }
  .cs-arrow { color: var(--ink-muted); font-size: 1.1rem; transition: transform 0.2s ease, color 0.2s ease; }
  .cs-card:hover .cs-arrow { transform: translate(2px, -2px); color: var(--signal); }
  .cs-card h3 { margin: 0; font-size: 1.1rem; }
  .cs-card p { margin: 0; font-size: 0.925rem; color: var(--ink-muted); }
  .cs-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: auto; padding-top: 0.75rem; }
  .cs-tags span {
    font-size: 0.75rem;
    color: var(--ink-muted);
    background: var(--surface-2);
    border-radius: 6px;
    padding: 0.15rem 0.5rem;
  }
</style>
